# LangSmith 可观测性（在 https://smith.langchain.com 获取 API Key）
# 注：langsmith@0.6 / @langchain/core@1 同时识别 LANGSMITH_TRACING / LANGCHAIN_TRACING_V2 /
# LANGSMITH_TRACING_V2 / LANGCHAIN_TRACING 四个变量名（见 node_modules/@langchain/core/dist/utils/callbacks.js），
# 此前的 LANGSMITH_TRACING_V2 并非无效写法，这里改用 langsmith 官方 README 推荐的规范名 LANGSMITH_TRACING。
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=filmgame-2

# 如使用 Anthropic API 直连（非 CLI 模式）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# 数据库
DATABASE_URL=postgres://filmgame:filmgame@localhost:5432/filmgame

# 认证（自用单密码）
APP_PASSWORD=change-me
# 会话签名密钥（32 字节 hex，可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成）
AUTH_SECRET=

# BYOK 密钥加密主密钥（32 字节 hex，生成方式同上）
ENCRYPTION_KEY=

# 运行模式：local 允许 claude_cli；deploy 禁用
DEPLOY_MODE=local
